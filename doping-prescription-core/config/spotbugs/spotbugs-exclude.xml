<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions. Every entry must carry a comment explaining why the finding is a false positive
  (docs/kod-standartlari.md §5). Keep this list as short as possible.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      JPA entities validate their invariants in the constructor (docs/kod-standartlari.md §2) but cannot be final,
      because Hibernate subclasses them for lazy proxies. The finalizer attack CT_CONSTRUCTOR_THROW warns about needs
      a malicious subclass with a finalizer; entities are never exposed outside their module and finalization is
      deprecated for removal in Java 21.
    -->
    <Match>
        <Package name="~com\.doping\.prescription\.[a-z]+\.persistence"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      Mapped entity columns are read and written by Hibernate through reflection: updated_at is written by the entity
      but only read by the database, published_at is set by SQL (seed) before any Java code writes it. SpotBugs cannot
      see reflective access, so these are false positives for persistence packages only.
    -->
    <Match>
        <Package name="~com\.doping\.prescription\.[a-z]+\.persistence"/>
        <Bug pattern="URF_UNREAD_FIELD,UWF_UNWRITTEN_FIELD"/>
    </Match>
    <!--
      RequestIdFilter echoes the client X-Request-Id only after it matched [A-Za-z0-9-]{1,64}, so no CR/LF or other
      header-splitting characters can reach the response; SpotBugs does not see the regex check.
    -->
    <Match>
        <Class name="com.doping.prescription.shared.error.RequestIdFilter"/>
        <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
    </Match>
    <!-- HttpSecurity.build() declares "throws Exception"; a SecurityFilterChain bean method cannot narrow it. -->
    <Match>
        <Class name="com.doping.prescription.auth.security.SecurityConfiguration"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
</FindBugsFilter>
