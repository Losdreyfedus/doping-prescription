<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions. Every entry must carry a comment explaining why the finding is a false positive
  (docs/kod-standartlari.md §5). Keep this list as short as possible.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      JPA entities validate their invariants in the constructor (docs/kod-standartlari.md §2) but cannot be final,
      because Hibernate subclasses them for lazy proxies. The finalizer attack CT_CONSTRUCTOR_THROW warns about needs
      a malicious subclass with a finalizer; entities are never exposed outside their module and finalization is
      deprecated for removal in Java 21.
    -->
    <Match>
        <Package name="~com\.doping\.prescription\.[a-z]+\.persistence"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
