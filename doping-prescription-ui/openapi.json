  "components" : {
    "schemas" : {
      "AnswerKeyRow" : {
        "required" : [ "correctKey", "orderNo", "topic" ],
        "type" : "object",
        "properties" : {
          "correctKey" : {
            "type" : "string"
          },
          "orderNo" : {
            "type" : "integer",
            "format" : "int32"
          },
          "scenarioKey" : {
            "type" : "string",
            "nullable" : true
          },
          "topic" : {
            "type" : "string"
          }
        }
      },
      "AnswerRequest" : {
        "required" : [ "quizToken", "responseMs", "selectedKey" ],
        "type" : "object",
        "properties" : {
          "quizToken" : {
            "minLength" : 1,
            "type" : "string"
          },
          "responseMs" : {
            "minimum" : 0,
            "type" : "integer",
            "format" : "int32"
          },
          "selectedKey" : {
            "minLength" : 1,
            "pattern" : "[A-D]",
            "type" : "string"
          }
        }
      },
      "AttemptView" : {
        "required" : [ "answers", "attemptId", "durationMin", "examId", "questions", "startedAt", "title" ],
        "type" : "object",
        "properties" : {
          "answers" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SavedAnswer"
            }
          },
          "attemptId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "durationMin" : {
            "type" : "integer",
            "format" : "int32"
          },
          "examId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "questions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/QuestionView"
            }
          },
          "startedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string"
          }
        }
      },
      "CardView" : {
        "required" : [ "content", "hasMicroQuiz", "impressionId", "pointsAvailable", "pool", "position", "reasonText", "topic" ],
        "type" : "object",
        "properties" : {
          "content" : {
            "$ref" : "#/components/schemas/ContentView"
          },
          "hasMicroQuiz" : {
            "type" : "boolean"
          },
          "impressionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "pointsAvailable" : {
            "type" : "integer",
            "format" : "int32"
          },
          "pool" : {
            "type" : "string",
            "enum" : [ "WEAK_TOPIC", "REVIEW_DUE", "EXPLORE", "POPULAR", "FALLBACK" ]
          },
          "position" : {
            "type" : "integer",
            "format" : "int32"
          },
          "reasonText" : {
            "type" : "string"
          },
          "topic" : {
            "$ref" : "#/components/schemas/TopicRef"
          }
        }
      },
      "ContentView" : {
        "required" : [ "contentId", "contentKind", "durationSec", "teacherName", "title" ],
        "type" : "object",
        "properties" : {
          "contentId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "contentKind" : {
            "type" : "string",
            "enum" : [ "CONCEPT", "SOLVED_EXAMPLE", "TIP" ]
          },
          "durationSec" : {
            "type" : "integer",
            "format" : "int32"
          },
          "teacherName" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "videoUrl" : {
            "type" : "string",
            "nullable" : true
          }
        }
      },
      "DebugCard" : {
        "required" : [ "appliedRules", "contentId", "difficultyFit", "examImportance", "freshness", "impressionId", "pool", "position", "quality", "reasonText", "score", "topicId", "weakness" ],
        "type" : "object",
        "properties" : {
          "appliedRules" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "contentId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "difficultyFit" : {
            "type" : "number",
            "format" : "double"
          },
          "examImportance" : {
            "type" : "number",
            "format" : "double"
          },
          "freshness" : {
            "type" : "number",
            "format" : "double"
          },
          "impressionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "pool" : {
            "type" : "string"
          },
          "position" : {
            "type" : "integer",
            "format" : "int32"
          },
          "quality" : {
            "type" : "number",
            "format" : "double"
          },
          "reasonText" : {
            "type" : "string"
          },
          "score" : {
            "type" : "number"
          },
          "topicId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "weakness" : {
            "type" : "number",
            "format" : "double"
          }
        }
      },
      "DemoLoginRequest" : {
        "required" : [ "slug" ],
        "type" : "object",
        "properties" : {
          "slug" : {
            "maxLength" : 32,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "DemoLoginResponse" : {
        "required" : [ "token", "user" ],
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/MeResponse"
          }
        }
      },
      "DemoUserResponse" : {
        "required" : [ "displayName", "role", "slug" ],
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "STUDENT", "ADMIN" ]
          },
          "slug" : {
            "type" : "string"
          }
        }
      },
      "Entry" : {
        "required" : [ "amount", "createdAt", "reason" ],
        "type" : "object",
        "properties" : {
          "amount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "reason" : {
            "type" : "string"
          }
        }
      },
      "ExamOption" : {
        "required" : [ "key", "text" ],
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          }
        }
      },
      "ExamResult" : {
        "required" : [ "attemptId", "blank", "byTopic", "correct", "examId", "net", "profileUpdate", "questions", "title", "wrong" ],
        "type" : "object",
        "properties" : {
          "attemptId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "blank" : {
            "type" : "integer",
            "format" : "int32"
          },
          "byTopic" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TopicResult"
            }
          },
          "correct" : {
            "type" : "integer",
            "format" : "int32"
          },
          "examId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "net" : {
            "type" : "number"
          },
          "profileUpdate" : {
            "$ref" : "#/components/schemas/ProfileUpdate"
          },
          "questions" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/QuestionResult"
            }
          },
          "title" : {
            "type" : "string"
          },
          "wrong" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "ExamSummary" : {
        "required" : [ "durationMin", "examId", "lastResult", "questionCount", "title" ],
        "type" : "object",
        "properties" : {
          "durationMin" : {
            "type" : "integer",
            "format" : "int32"
          },
          "examId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "inProgressAttemptId" : {
            "type" : "string",
            "format" : "uuid",
            "nullable" : true
          },
          "lastResult" : {
            "$ref" : "#/components/schemas/LastResult"
          },
          "questionCount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          }
        }
      },
      "FeedDebug" : {
        "required" : [ "cards", "slug", "weakestTopics" ],
        "type" : "object",
        "properties" : {
          "cards" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DebugCard"
            }
          },
          "slug" : {
            "type" : "string"
          },
          "weakestTopics" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/WeakTopic"
            }
          }
        }
      },
      "FeedPage" : {
        "required" : [ "algoVersion", "cards", "demoVideoSpeed", "nextCursor", "personalized", "sessionId" ],
        "type" : "object",
        "properties" : {
          "algoVersion" : {
            "type" : "string"
