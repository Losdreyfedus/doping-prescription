{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Doping Prescription API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8080"
  } ],
  "security" : [ {
    "bearer" : [ ]
  } ],
  "paths" : {
    "/api/admin/users" : {
      "get" : {
        "operationId" : "users",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/UserSummary"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "admin-user-controller" ]
      }
    },
    "/api/auth/demo-login" : {
      "post" : {
        "operationId" : "demoLogin",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DemoLoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DemoLoginResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/auth/demo-users" : {
      "get" : {
        "operationId" : "demoUsers",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/DemoUserResponse"
                  }
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    },
    "/api/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "auth-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "DemoLoginRequest" : {
        "required" : [ "slug" ],
        "type" : "object",
        "properties" : {
          "slug" : {
            "maxLength" : 32,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "DemoLoginResponse" : {
        "required" : [ "token", "user" ],
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
          "user" : {
            "$ref" : "#/components/schemas/MeResponse"
          }
        }
      },
      "DemoUserResponse" : {
        "required" : [ "displayName", "role", "slug" ],
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          }
        }
      },
      "MeResponse" : {
        "required" : [ "displayName", "personalizationEnabled", "role", "slug", "userId" ],
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "examDate" : {
            "type" : "string",
            "format" : "date",
            "nullable" : true
          },
          "personalizationEnabled" : {
            "type" : "boolean"
          },
          "role" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "UserSummary" : {
        "required" : [ "displayName", "personalizationEnabled", "role", "slug", "userId" ],
        "type" : "object",
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "personalizationEnabled" : {
            "type" : "boolean"
          },
          "role" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
